{
  "name": "schaapsvis-members",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "MEMBERS_ENABLED": "off",
    "SITE_ORIGIN": "https://schaapsvishandel.nl",
    "MAIL_FROM": "schaapsv@schaapsvishandel.nl",
    "SMTP_HOST": "mail.schaapsvishandel.nl",
    "SMTP_HELO_NAME": "mail.schaapsvishandel.nl",
    "SMTP_PORT": "587",
    "SMTP_USERNAME": "schaapsv@schaapsvishandel.nl",
  },
  // D1 en private R2 staan per omgeving in de EU. Mail gebruikt de bestaande
  // DirectAdmin-mailbox. SMTP_PASSWORD en de auth-secrets staan als versleutelde
  // Cloudflare secrets; stel ze lokaal alleen met aparte testwaarden in.
  "env": {
    "preview": {
      "name": "schaapsvis-members-preview",
      "routes": [
        { "pattern": "preview.schaapsvishandel.nl/api/members/*", "zone_name": "schaapsvishandel.nl" }
      ],
      "vars": {
        "SMTP_DIAGNOSTICS": "off",
        "MEMBERS_ENABLED": "off",
        "SITE_ORIGIN": "https://preview.schaapsvishandel.nl",
        "MAIL_FROM": "schaapsv@schaapsvishandel.nl",
        "SMTP_HOST": "mail.schaapsvishandel.nl",
    "SMTP_HELO_NAME": "mail.schaapsvishandel.nl",
        "SMTP_PORT": "587",
        "SMTP_USERNAME": "schaapsv@schaapsvishandel.nl",
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "schaapsvis-members-preview", "database_id": "0a97c8e6-c829-4b5e-9eb7-f4154282898d", "migrations_dir": "../../migrations" }
      ],
      "r2_buckets": [
        { "binding": "STUDENT_PROOFS", "bucket_name": "schaapsvis-student-proofs-preview", "jurisdiction": "eu" }
      ]
    },
    "production": {
      "name": "schaapsvis-members",
      "routes": [
        { "pattern": "schaapsvishandel.nl/api/members/*", "zone_name": "schaapsvishandel.nl" }
      ],
      "vars": {
        "SMTP_DIAGNOSTICS": "off",
        "MEMBERS_ENABLED": "on",
        "SITE_ORIGIN": "https://schaapsvishandel.nl",
        "MAIL_FROM": "schaapsv@schaapsvishandel.nl",
        "SMTP_HOST": "mail.schaapsvishandel.nl",
    "SMTP_HELO_NAME": "mail.schaapsvishandel.nl",
        "SMTP_PORT": "587",
        "SMTP_USERNAME": "schaapsv@schaapsvishandel.nl",
        "ADMIN_EMAILS": "schaapsv@schaapsvishandel.nl",
        "ADMIN_IPS": "212.120.114.226,2001:4860:7:61f::f5",
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "schaapsvis-members", "database_id": "cc7d01e2-914c-407d-b08f-269c85e67dc2", "migrations_dir": "../../migrations" }
      ],
      "r2_buckets": [
        { "binding": "STUDENT_PROOFS", "bucket_name": "schaapsvis-student-proofs", "jurisdiction": "eu" }
      ]
    }
  }
}
