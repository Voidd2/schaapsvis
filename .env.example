# The site stays locked unless public launch is explicitly enabled. When locked,
# access requires both a strong site password and an independent random cookie token.
# Set SITE_PUBLIC=launch-approved only after the owner approves the launch.
SITE_PUBLIC=off
SITE_PASSWORD=
SITE_ACCESS_TOKEN=

# Set this to the final canonical YourLocalCityGuide origin. The footer backlink
# is deliberately hidden until this value is present.
CITYGUIDE_URL=

# Existing production integrations.
BESTELLING_WEBHOOK_URL=
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
